{
  "name": "@kazda01/pi-tab-status",
  "version": "0.1.1",
  "description": "Live Pi status and short AI-generated descriptions for terminal tabs, sessions, tmux, herdr, and zellij.",
  "type": "module",
  "license": "MIT",
  "author": "kazda01",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kazda01/pi-tab-status.git"
  },
  "homepage": "https://github.com/kazda01/pi-tab-status#readme",
  "bugs": {
    "url": "https://github.com/kazda01/pi-tab-status/issues"
  },
  "keywords": [
    "herdr",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "pi-package",
    "terminal-title",
    "tmux",
    "zellij"
  ],
  "files": [
    "src",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "exports": "./src/index.ts",
  "scripts": {
    "check": "npm run typecheck && npm run test:coverage && npm run test:smoke && npm run pack:check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:smoke": "node test/smoke.mjs",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "@juanibiapina/pi-extension-settings": "^0.10.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@earendil-works/pi-tui": "0.84.1",
    "@types/node": "^22.19.0",
    "@vitest/coverage-v8": "4.1.6",
    "typescript": "^5.9.3",
    "vitest": "4.1.6"
  }
}
